# Bearer token required for all non-health endpoints. Generate something random.
API_BEARER_TOKEN=change-me-to-a-random-secret

# File size limits (MB)
MAX_FILE_SIZE_SYNC_MB=5
MAX_FILE_SIZE_ASYNC_MB=100

# Timeouts (seconds)
SYNC_TIMEOUT_SECONDS=120
ASYNC_POLL_INTERVAL_SECONDS=2
PDF24_REQUEST_TIMEOUT_SECONDS=300

# Job lifecycle
JOB_TTL_SECONDS=7200
JOB_CLEANUP_INTERVAL_SECONDS=1800

# CORS: comma-separated list, or * for all
CORS_ORIGINS=*

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text

# Storage
TMP_DIR=./tmp

# PDF24 client
PDF24_MAX_RETRIES=3
PDF24_SERVER_COUNT=30

# Batch processing
BATCH_MAX_FILES=50
BATCH_MAX_TOTAL_SIZE_MB=500
BATCH_CONCURRENCY=3
